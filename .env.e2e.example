# Copy to .env.e2e.local AFTER choosing the test environment.
# Use two confirmed, dedicated accounts; the learner needs at least one credit.
# Public anon/publishable key only. Never use a service-role or admin key.
E2E_SUPABASE_URL=
E2E_SUPABASE_KEY=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_LEARNER_EMAIL=
E2E_LEARNER_PASSWORD=
# Explicit opt-in: live runs create records and transfer one credit.
E2E_CONFIRM_DATA_WRITES=no
