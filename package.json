{
  "name": "baamm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node tests/profile-and-skills.mjs && node tests/password-recovery.mjs && node tests/discovery-and-exchanges.mjs && node tests/discovery-filters.mjs && node tests/discovery-suggestions.mjs",
    "preview": "vite preview",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test --project=smoke --project=regression",
    "test:e2e:profiles": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test --project=regression",
    "test:e2e:live": "E2E_LIVE=1 PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test --project=live",
    "test:e2e:report": "playwright show-report --host 127.0.0.1",
    "test:database": "node tests/database-security.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supabase": "^2.121.0",
    "vite": "^8.3.0"
  }
}
